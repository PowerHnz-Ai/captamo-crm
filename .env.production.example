# Copie para a VPS como /var/www/ultra-api/.env.production e preencha.
# Não commite o arquivo real com segredos.
#
# Gerar segredos aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # CREDENTIALS_ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"      # CRON_SECRET / CHECKLIST_INTEGRATION_API_KEY / WHATSAPP_VERIFY_TOKEN

# --- Aplicação ---
APP_URL=https://<DOMINIO_DO_CRM>
CRM_DEFAULT_COMPANY_ID=
CRM_DAILY_CAP=1000

# Super-admins da plataforma (separados por vírgula) — cadastram e excluem clientes
PLATFORM_ADMIN_EMAILS=mr.misterhub@gmail.com,admincaptamo@gmail.com

# --- Banco de dados (MariaDB local da VPS — criado pelo setup-server.sh) ---
DATABASE_URL=mysql://ultrahub:<SENHA>@127.0.0.1:3306/ultrahub

# --- Segredos internos (gere valores NOVOS por ambiente) ---
# Chave mestra de criptografia das credenciais WhatsApp por empresa (32 bytes base64).
# PRECISA ser a mesma em todos os ambientes que acessam o MESMO banco.
# NUNCA reutilize a chave de outro ambiente/banco.
CREDENTIALS_ENCRYPTION_KEY=
# Autoriza o cron de campanhas (deploy-remote.sh instala /etc/cron.d/ultra-campaigns com este valor)
CRON_SECRET=
# Integração Captamo Tasks (app externo) → CRM (confirmação de tarefas)
CHECKLIST_INTEGRATION_API_KEY=
# URL do app externo Captamo Tasks (checklist operacional) — o CRM encaminha para cá
TASK_CHECKLIST_URL=https://app.misterodonto.com.br
NEXT_PUBLIC_TASK_CHECKLIST_URL=https://app.misterodonto.com.br

# --- WhatsApp (Meta Cloud API) ---
# Token de verificação do webhook (você define; informe o mesmo no painel da Meta)
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Opcional — obtido automaticamente do token se omitido; necessário para templates com imagem no cabeçalho
META_APP_ID=
# LEGADAS (globais) — deixe vazias; as credenciais por empresa são cadastradas
# na tela de Clientes (platform admin) e ficam criptografadas no banco.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# --- Firebase Admin SDK (service account do projeto) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole com \n literais ou entre aspas duplas com quebras escapadas
FIREBASE_PRIVATE_KEY=
# Projetos novos usam <projeto>.firebasestorage.app — defina explicitamente
FIREBASE_STORAGE_BUCKET=

# --- Firebase client (config do web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Custo estimado por campanha (USD por mensagem, por categoria de template) ---
CAMPAIGN_COST_MARKETING_USD=0.0625
CAMPAIGN_COST_UTILITY_USD=0.0068
CAMPAIGN_COST_AUTHENTICATION_USD=0.0068

# --- Provedores alternativos (opcional) ---
WASENDER_API_KEY=
WASENDER_API_BASE_URL=https://www.wasenderapi.com/api
WASENDER_SESSION_ID=

EVOLUTION_API_KEY=
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE_ID=
