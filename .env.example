# Credenciais Meta LEGADAS (globais) — usadas apenas pelo seed para migrar a
# empresa padrão. Clientes novos são configurados pela tela de Clientes
# (platform admin), com token criptografado por empresa no banco.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Opcional — obtido automaticamente do token se omitido; necessário para templates com imagem no cabeçalho
META_APP_ID=
META_GRAPH_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=misterhubcrm_webhook_2026
APP_URL=https://app.misterodonto.com.br
CRM_DAILY_CAP=1000

# Banco de dados do CRM (MariaDB). Em dev, use túnel SSH para a VPS:
# ssh -N -L 3306:127.0.0.1:3306 root@31.97.85.113
DATABASE_URL=mysql://ultrahub:SENHA@127.0.0.1:3306/ultrahub

# Firebase do projeto (service account — Admin SDK)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Bucket do Firebase Storage (opcional — usa NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET se vazio)
FIREBASE_STORAGE_BUCKET=

# Empresa padrão para webhook WhatsApp e integrações sem sessão de usuário
CRM_DEFAULT_COMPANY_ID=

# E-mails do(s) super-admin(s) da plataforma (separados por vírgula).
# Só esses logins podem cadastrar clientes novos (empresas + gerentes).
PLATFORM_ADMIN_EMAILS=

# Chave mestra de criptografia das credenciais por empresa (32 bytes base64).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PRECISA ser a mesma em todos os ambientes que acessam o mesmo banco.
CREDENTIALS_ENCRYPTION_KEY=

# Custo estimado por campanha (USD por mensagem enviada, por categoria de template)
CAMPAIGN_COST_MARKETING_USD=0.0625
CAMPAIGN_COST_UTILITY_USD=0.0068
CAMPAIGN_COST_AUTHENTICATION_USD=0.0068

# Firebase client (mesmos valores do task-checklist/config.js)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Autoriza o cron de campanhas (POST /api/campaigns/process).
# Gerar com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Provedores alternativos (opcional — ou configure em companies/{id}.whatsapp)
WASENDER_API_KEY=
WASENDER_API_BASE_URL=https://www.wasenderapi.com/api
WASENDER_SESSION_ID=

EVOLUTION_API_KEY=
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE_ID=
